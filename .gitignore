# Unity (based on github/gitignore Unity.gitignore)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Eye-tracking logs written by EyeTrackingManager (Application.dataPath + "/Logs/")
/[Aa]ssets/[Ll]ogs/
/[Aa]ssets/[Ll]ogs.meta

# Asset Store packages and Package Manager samples that are imported locally, not redistributed
/[Aa]ssets/Sci-Fi Styled Modular Pack/
/[Aa]ssets/Sci-Fi Styled Modular Pack.meta
/[Aa]ssets/[Ss]amples/Varjo XR Plugin/
/[Aa]ssets/[Ss]amples/Varjo XR Plugin.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDEs
.vs/
.idea/
.vscode/
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
desktop.ini
